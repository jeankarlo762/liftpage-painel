# Banco (Railway Postgres fornece DATABASE_URL automaticamente)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/painel"

# URL pública do painel (usada no script de estatísticas e no OAuth do GitHub)
APP_URL="http://localhost:3000"

# Segredos do app (gere com: openssl rand -base64 32)
SESSION_SECRET=""
ENCRYPTION_KEY=""   # 32 bytes em base64, criptografa os tokens de GitHub/Railway salvos

# Claude (agente que gera as páginas)
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"

# GitHub OAuth App (Configurações > Conectar GitHub)
# Callback: {APP_URL}/api/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Hospedagem automática (plano Premium): conta GitHub/Railway da empresa
PLATFORM_GITHUB_TOKEN=""        # token com permissão de criar repos
PLATFORM_GITHUB_OWNER=""        # org ou usuário onde os repos dos clientes Premium ficam
PLATFORM_RAILWAY_TOKEN=""       # token de time do Railway
PLATFORM_RAILWAY_WORKSPACE_ID="" # opcional

# Checkout: um link por plano e forma de cobrança (mensal ou vitalício)
CHECKOUT_URL_BASIC_MONTHLY=""
CHECKOUT_URL_BASIC_LIFETIME=""
CHECKOUT_URL_PRO_MONTHLY=""
CHECKOUT_URL_PRO_LIFETIME=""
CHECKOUT_URL_PREMIUM_MONTHLY=""
CHECKOUT_URL_PREMIUM_LIFETIME=""
PAYMENT_WEBHOOK_SECRET=""
